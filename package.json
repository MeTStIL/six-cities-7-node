{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "vite-node src/main.ts",
    "dev-cli": "vite-node src/main.cli.ts",
    "build": "npm run typecheck && rimraf dist && vite build && chmod u+x dist/main.cli.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "mock:server": "json-server ./mocks/mock-server-data.json --port 3000"
  },
  "devDependencies": {
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "json-server": "0.17.3",
    "prettier": "^3.9.9",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "^5.3.3",
    "vite": "5",
    "vite-node": "1.6.0"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dayjs": "1.11.10"
  }
}
